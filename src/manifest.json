{
  "manifest_version": 3,
  "name": "A Font Face-off",
  "version": "1.0.0",
  "description": "Compare fonts side by side",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "browser-api.js",
        "messaging-utils.js",
        "sroulette-utils.js",
        "site-detection-utils.js",
        "local-font-utils.js",
        "font-warm-utils.js",
        "left-toolbar.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "browser-api.js",
        "messaging-utils.js",
        "sroulette-utils.js",
        "site-detection-utils.js",
        "content-sroulette-runtime.js",
        "font-face-utils.js",
        "font-swap-utils.js",
        "local-font-utils.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' data: blob: https:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-font-face-capture.js",
        "wf.css",
        "left-toolbar-iframe.html",
        "left-toolbar-iframe.js",
        "icons/featherIcons/unhide.svg",
        "icons/heroIcons/unhide.svg",
        "custom-fonts-starter.css",
        "sil-fonts.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "background": {
    "scripts": [
      "browser-api.js",
      "messaging-utils.js",
      "config-utils.js",
      "css-generators.js",
      "font-url-utils.js",
      "font-face-utils.js",
      "page-font-utils.js",
      "sroulette-utils.js",
      "block-javascript-utils.js",
      "background-font-runtime.js",
      "gdrive-config.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "a-font-face-off@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity",
          "authenticationInfo",
          "technicalAndInteraction"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "A Font Face-off",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
