{
  "name": "a-font-face-off",
  "private": true,
  "version": "0.0.0",
  "description": "Build scripts for A Font Face-off (web-ext)",
  "scripts": {
    "prebuild": "node scripts/set-debug.js false",
    "build": "NO_UPDATE_NOTIFIER=1 web-ext build",
    "postbuild": "node scripts/set-debug.js true",
    "build:latest": "npm run build -- --filename latest.xpi",
    "build:chromium-mv3": "node scripts/build-chromium-mv3.js",
    "build:chromium-mv3-zip": "node scripts/zip-chromium-mv3.js",
    "pack:chromium-crx": "node scripts/pack-chromium-crx.js",
    "build:chromium-crx": "npm run build:chromium-mv3 && npm run pack:chromium-crx",
    "build:chromium-smoke-mv3": "node scripts/build-chromium-smoke-mv3.js",
    "pack:chromium-smoke-crx": "node scripts/pack-chromium-crx.js --source-dir ztemp/chromium-smoke-mv3-src --key ztemp/chromium-smoke-key.pem --zip ztemp/chromium-smoke-mv3.zip --out web-ext-artifacts/affo-chromium-mv3-smoke.crx",
    "build:chromium-smoke-crx": "npm run build:chromium-smoke-mv3 && npm run pack:chromium-smoke-crx",
    "gf:update": "node scripts/update-gf-metadata.js",
    "lint": "eslint --no-warn-ignored src/*.js scripts/ tests/**/*.js",
    "inspect:android-firefox": "node scripts/android-firefox-inspect.js",
    "test:android:emulator": "npm run build:latest && node scripts/android-emulator-test.js",
    "test": "node --test 'tests/**/*.test.js'",
    "test:integration": "npm run build:latest && node --test --test-concurrency=1 'tests/**/*.itest.js'",
    "test:chrome": "npm run build:chromium && node scripts/test-desktop-chromium.js",
    "build:chromium": "node scripts/build-chromium-mv3.js"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "selenium-webdriver": "^4.40.0",
    "web-ext": "^9.2.0"
  }
}
